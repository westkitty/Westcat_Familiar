{
  "name": "westcat-familiar",
  "version": "0.1.0",
  "private": true,
  "description": "WESTCAT Familiar — a local-first animated desktop familiar (Electron + React + TypeScript + Vite). The familiar is the interface.",
  "main": "out/main/electronMain.js",
  "scripts": {
